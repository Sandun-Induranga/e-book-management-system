@page
@model LoginModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-5">
    <h1 class="text-center mb-4">@ViewData["Title"]</h1>

    <div class="row justify-content-center">
        <!-- Login Form -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form id="account" method="post">
                        <h2 class="text-center mb-4">Welcome Back!</h2>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Email -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <!-- Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="form-label">Password</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <!-- Remember Me -->
                        <div class="form-check mb-3">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label" asp-for="Input.RememberMe">Remember Me</label>
                        </div>

                        <!-- Submit Button -->
                        <button id="login-submit" type="submit" class="w-100 btn btn-primary btn-lg">Log In</button>
                    </form>

                    <!-- Additional Links -->
                    <div class="text-center mt-4">
                        <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none">Forgot your password?</a>
                        <p class="mt-2">
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none">Register as a new user</a>
                        </p>
                        <p class="mt-2">
                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-decoration-none">Resend email confirmation</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- External Login Section -->
        <div class="col-md-6 mt-4 mt-md-0">
            <div class="card shadow-sm">
                <div class="card-body">
                    <section>
                        <h3 class="text-center mb-3">Sign In with Your Email</h3>
                        <hr />
                        <img src="https://t4.ftcdn.net/jpg/00/05/86/25/360_F_5862533_wQ6IJRVm6vLtub3aqirHc0AsUK3EfloS.jpg" class="img-fluid d-block mx-auto mb-3" alt="External Login" />
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}