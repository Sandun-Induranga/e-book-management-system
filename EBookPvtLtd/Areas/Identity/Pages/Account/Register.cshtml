@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">
    <h1 class="text-center mb-4">@ViewData["Title"]</h1>

    <div class="row justify-content-center">
        <!-- Registration Form -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <h2 class="text-center mb-4">Create a New Account</h2>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Email -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <!-- Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password">Password</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <!-- First Name -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.FirstName" class="form-control" placeholder="First Name" />
                            <label asp-for="Input.FirstName">First Name</label>
                            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                        </div>

                        <!-- Last Name -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.LastName" class="form-control" placeholder="Last Name" />
                            <label asp-for="Input.LastName">Last Name</label>
                            <span asp-validation-for="Input.LastName" class="text-danger"></span>
                        </div>

                        <!-- Phone -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Phone" class="form-control" placeholder="Phone" />
                            <label asp-for="Input.Phone">Phone</label>
                            <span asp-validation-for="Input.Phone" class="text-danger"></span>
                        </div>

                        <!-- Address -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Address" class="form-control" placeholder="Address" />
                            <label asp-for="Input.Address">Address</label>
                            <span asp-validation-for="Input.Address" class="text-danger"></span>
                        </div>

                        <!-- Submit Button -->
                        <button id="registerSubmit" type="submit" class="w-100 btn btn-primary btn-lg">Register</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- External Login Section -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <section>
                        <h3 class="text-center mb-3">E-Book (Pvt) Ltd.</h3>
                        <img src="https://t4.ftcdn.net/jpg/00/05/86/25/360_F_5862533_wQ6IJRVm6vLtub3aqirHc0AsUK3EfloS.jpg" class="img-fluid d-block mx-auto mb-3" alt="External Login" />
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
