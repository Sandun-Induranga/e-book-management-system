@{
    ViewData["Title"] = "Home Page";
}

<body>
    <!-- Hero Section -->
    <div class="hero-section text-center">
        <div class="container">
            <h1>Welcome to E-Book (Pvt) Ltd</h1>
            <p>Discover your next favorite book!</p>
            <a href="/Books/Index" class="btn btn-primary btn-lg mt-3">Browse Books</a>
        </div>
    </div>

    <!-- Features Section -->
    <div class="container py-5 mb-5">
        <h2 class="text-center mb-4">Why Choose Us?</h2>
        <div class="row text-center">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Wide Selection</h5>
                        <p class="card-text">Explore books across various genres and categories.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Seamless Shopping</h5>
                        <p class="card-text">Add to cart, checkout, and enjoy reading effortlessly.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Best Deals</h5>
                        <p class="card-text">Get amazing discounts on your favorite books.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer text-center mt-5 pt-5">
        <div class="container">
            <p>&copy; 2024 E-Book (Pvt) Ltd. All Rights Reserved.</p>
            <a href="/Home/Privacy">Privacy Policy</a> | <a href="/Home/Terms">Terms & Conditions</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
