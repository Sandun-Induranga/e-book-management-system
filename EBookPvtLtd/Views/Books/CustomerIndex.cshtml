@model IEnumerable<EBookPvtLtd.Models.Book>

@{
    ViewData["Title"] = "Browse Books";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-5">
    <h1 class="text-center mb-4">Browse Our Book Collection</h1>

    <div class="row">
        @foreach (var book in Model)
        {
            <div class="col-md-3">
                <div class="card mb-4 shadow-sm">
                    <img class="card-img-top" src="@book.ImagePath" alt="@book.Title" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title text-truncate">@book.Title</h5>
                        <p class="card-text"><strong>Author:</strong> @book.Author</p>
                        <p class="card-text"><strong>Genre:</strong> @book.Genre</p>
                        <p class="card-text text-success"><strong>Price:</strong> $@book.Price</p>
                        <p class="card-text text-muted"><strong>Available:</strong> @book.Quantity</p>
                        <p class="card-text"><small class="text-muted text-truncate">@book.Description</small></p>
                            <button class="btn btn-info btn-sm w-100 view-feedback" data-id="@book.BookId" data-bs-toggle="modal" data-bs-target="#feedbackModal">View Feedback</button>
                            <button class="btn btn-success btn-sm w-100 add-to-cart mt-2" data-id="@book.BookId">Add to Cart</button>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-4">
        <a asp-action="Cart" class="btn btn-secondary">Go to Cart</a>
    </div>
</div>

<!-- Feedback Modal -->
<div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="feedbackModalLabel">Feedback</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Feedback Section -->
                <div id="feedbackSection" class="mb-3">
                    <h6>Customer Feedback</h6>
                    <ul class="list-group feedback-list">
                        <!-- Feedback items will be dynamically inserted here -->
                    </ul>
                </div>

                <!-- Add Feedback Form -->
                <form id="feedbackForm">
                    <input type="hidden" id="feedbackBookId" />
                    <div class="mb-3">
                        <label for="customerName" class="form-label">Your Name</label>
                        <input type="text" class="form-control" id="customerName" placeholder="Enter your name" required>
                    </div>
                    <div class="mb-3">
                        <label for="feedbackContent" class="form-label">Your Feedback</label>
                        <textarea class="form-control" id="feedbackContent" rows="3" placeholder="Share your thoughts about this book" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Submit Feedback</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize cart from localStorage or create an empty one
            const cart = JSON.parse(localStorage.getItem('cart')) || [];

            // Add to Cart functionality
            document.querySelectorAll('.add-to-cart').forEach(button => {
                button.addEventListener('click', function () {
                    const bookId = parseInt(this.getAttribute('data-id'));

                    // Check if the book is already in the cart
                    const existingItem = cart.find(item => item.BookId === bookId);
                    if (existingItem) {
                        existingItem.Quantity += 1; // Increment the quantity
                    } else {
                        cart.push({ BookId: bookId, Quantity: 1 }); // Add new item with Quantity = 1
                    }

                    // Save cart back to localStorage
                    localStorage.setItem('cart', JSON.stringify(cart));
                    alert('Item added to cart!');
                });
            });

                // View Feedback functionality
                document.querySelectorAll('.view-feedback').forEach(button => {
                    button.addEventListener('click', function () {
                        const bookId = this.getAttribute('data-id');
                        console.log('Fetching feedback for bookId:', bookId);

                        const feedbackList = document.querySelector('.feedback-list');
                        feedbackList.innerHTML = '<li class="list-group-item">Loading feedback...</li>'; // Placeholder
                        document.getElementById('feedbackBookId').value = bookId; // Set the bookId in the feedback form

                        // Fetch feedback for the selected book
                        fetch(`/Feedbacks/GetFeedback?bookId=${bookId}`)
                            .then(response => {
                                if (!response.ok) {
                                    throw new Error('Failed to fetch feedback.');
                                }
                                return response.json();
                            })
                            .then(feedbacks => {
                                feedbackList.innerHTML = ''; // Clear placeholder

                                if (feedbacks.length === 0) {
                                    feedbackList.innerHTML = '<li class="list-group-item text-muted">No feedback available for this book.</li>';
                                } else {
                                    feedbacks.forEach(feedback => {
                                        const listItem = document.createElement('li');
                                        listItem.classList.add('list-group-item');
                                    listItem.innerHTML = `<div class="ms-2 me-auto" >
                                        <div class="fw-bold" > ${ feedback.customerName } </div>
                                            <p class="mb-1" > ${ feedback.content } </p>
                                                </div>
                                                <small class="text-muted text-end" > ${ new Date(feedback.createdAt).toLocaleDateString() } </small>`;
                                        feedbackList.appendChild(listItem);
                                    });
                                }
                            })
                            .catch(err => {
                                console.error('Error fetching feedback:', err);
                                feedbackList.innerHTML = '<li class="list-group-item text-danger">Error loading feedback. Please try again later.</li>';
                            });
                    });
                });

            // Submit Feedback functionality
            document.getElementById('feedbackForm').addEventListener('submit', async function (e) {
                e.preventDefault();

                const bookId = document.getElementById('feedbackBookId').value;
                const customerName = document.getElementById('customerName').value;
                const feedbackContent = document.getElementById('feedbackContent').value;

                try {
                    const response = await fetch('/Feedbacks/AddFeedback', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ BookId: bookId, CustomerName: customerName, Content: feedbackContent })
                    });

                    if (response.ok) {
                        alert('Feedback submitted!');
                        document.getElementById('feedbackForm').reset();
                        window.location.reload(); // Refresh the page to show updated feedback
                    } else {
                        alert('Failed to submit feedback.');
                    }
                } catch (err) {
                    console.error("Error submitting feedback:", err);
                    alert("An error occurred while submitting feedback.");
                }
            });
        });
    </script>
}