@model IEnumerable<EBookPvtLtd.Models.Book>

@{
    ViewData["Title"] = "Books";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-5">
    <h1 class="text-center mb-4">Manage Book Collection</h1>

    <p class="text-end">
        <a asp-action="Create" class="btn btn-primary">Create New Book</a>
    </p>

    <div class="row">
        @foreach (var book in Model)
        {
            <div class="col-md-3">
                <div class="card mb-4 shadow-sm">
                    <img class="card-img-top" src="@book.ImagePath" alt="@book.Title" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title text-truncate">@book.Title</h5>
                        <p class="card-text"><strong>Author:</strong> @book.Author</p>
                        <p class="card-text"><strong>Genre:</strong> @book.Genre</p>
                        <p class="card-text text-success"><strong>Price:</strong> $@book.Price</p>
                        <p class="card-text text-muted"><strong>Available:</strong> @book.Quantity</p>
                        <p class="card-text"><small class="text-muted text-truncate">@book.Description</small></p>
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-controller="Feedbacks" asp-action="Index" asp-route-bookId="@book.BookId" class="btn btn-info">View Feedback</a>
                            <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@book.BookId" class="btn btn-danger btn-sm">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

