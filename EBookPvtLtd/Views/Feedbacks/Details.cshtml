@model IEnumerable<EBookPvtLtd.Models.Feedback>

@{
    ViewData["Title"] = "Feedback";
    var book = ViewBag.Book as EBookPvtLtd.Models.Book; // Cast ViewBag.Book to Book model
}

<h1>Feedback for @book.Title</h1>

<div class="card mb-4 shadow-sm">
    <div class="row g-0">
        <div class="col-md-4">
            <img src="@book.ImagePath" class="img-fluid rounded-start" alt="@book.Title" />
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h5 class="card-title">@book.Title</h5>
                <p class="card-text"><strong>Author:</strong> @book.Author</p>
                <p class="card-text"><strong>Genre:</strong> @book.Genre</p>
                <p class="card-text"><strong>Price:</strong> $@book.Price</p>
                <p class="card-text"><small class="text-muted">@book.Description</small></p>
            </div>
        </div>
    </div>
</div>

<h3 class="mt-4">Customer Feedback</h3>

@if (!Model.Any())
{
    <p>No feedback available for this book.</p>
}
else
{
    <div class="list-group">
        @foreach (var feedback in Model)
        {
            <div class="list-group-item">
                <h5>@feedback.CustomerName</h5>
                <p>@feedback.Content</p>
                <small class="text-muted">Posted on: @feedback.CreatedAt.ToString("f")</small>
            </div>
        }
    </div>
}
