@model IEnumerable<EBookPvtLtd.Models.Order>

@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<h1 class="mt-2">@ViewData["Title"]</h1>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Order Date</th>
            <th>Status</th>
            <th>First Name</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.OrderDate)</td>
                <td>
                    <span class="badge @((item.Status == "Completed") ? "bg-success" : (item.Status == "Pending") ? "bg-warning" : "bg-secondary")">
                        @Html.DisplayFor(modelItem => item.Status)
                    </span>
                </td>
                <td>@Html.DisplayFor(modelItem => item.Customer.FirstName)</td>
                <td class="text-center">
                    <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-info btn-sm">Details</a>
                    @if (item.Status == "Pending")
                    {
                        <form asp-action="CancelOrder" asp-route-id="@item.OrderId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm">Cancel</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

