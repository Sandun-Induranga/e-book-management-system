@model IEnumerable<EBookPvtLtd.Models.Order>

@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<h1 class="mt-2">@ViewData["Title"]</h1>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Order Date</th>
            <th>Status</th>
            <th>First Name</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.OrderDate)</td>
                <td>
                    <span class="badge @((item.Status == "Completed") ? "bg-success" : (item.Status == "Pending") ? "bg-warning" : "bg-secondary")">
                        @Html.DisplayFor(modelItem => item.Status)
                    </span>
                </td>
                <td>@Html.DisplayFor(modelItem => item.Customer.FirstName)</td>
                <td class="text-center">
                    <button type="button" class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#detailsModal" data-order-id="@item.OrderId">
                        Details
                    </button>
                    @if (item.Status == "Pending")
                    {
                        <form asp-action="CancelOrder" asp-route-id="@item.OrderId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm">Cancel</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<!-- Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailsModalLabel">Order Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailsModalContent">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Attach event to buttons with data-bs-target="#detailsModal"
            $('#detailsModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget); // Button that triggered the modal
                var orderId = button.data('order-id'); // Extract info from data-order-id attribute

                // Make an AJAX call to fetch order details
                var modal = $(this);
                var modalContent = modal.find('#detailsModalContent');
                modalContent.html('<p>Loading...</p>'); // Placeholder content

                $.get('/Orders/Details/' + orderId, function (data) {
                    modalContent.html(data); // Replace modal content with the response
                }).fail(function () {
                    modalContent.html('<p class="text-danger">Failed to load order details. Please try again.</p>');
                });
            });

            $('#detailsModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget); // Button that triggered the modal
                var orderId = button.data('order-id'); // Extract info from data-order-id attribute
                var modalContent = $('#detailsModalContent');

                modalContent.html('<p>Loading...</p>'); // Placeholder

                // Fetch order details
                $.getJSON('/Orders/Details/' + orderId, function (data) {
                    var content = `
            <div class="container p-4">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body">
                        <h4 class="card-title text-primary">Order Information</h4>
                        <p><strong>Order ID:</strong> ${data.orderId}</p>
                        <p><strong>Order Date:</strong> ${new Date(data.orderDate).toLocaleDateString()}</p>
                        <p><strong>Status:</strong> <span class="badge ${data.status === 'Completed' ? 'bg-success' : 'bg-warning'}">${data.status}</span></p>
                        <p><strong>Total Amount:</strong> <span class="text-success">$${data.totalAmount}</span></p>
                    </div>
                </div>

                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body">
                        <h4 class="card-title text-primary">Customer Information</h4>
                        <p><strong>Name:</strong> ${data.customer.firstName} ${data.customer.lastName}</p>
                        <p><strong>Email:</strong> <a href="mailto:${data.customer.email}" class="text-decoration-none">${data.customer.email}</a></p>
                    </div>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h4 class="card-title text-primary">Order Items</h4>
                        <table class="table table-hover table-bordered mt-3">
                            <thead class="table-light">
                                <tr>
                                    <th>Title</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Total Price</th>
                                </tr>
                            </thead>
                            <tbody>`;

                    data.items.forEach(item => {
                        content += `
                                <tr>
                                    <td>${item.title}</td>
                                    <td>$${item.price.toFixed(2)}</td>
                                    <td>${item.quantity}</td>
                                    <td>$${item.totalPrice}</td>
                                </tr>`;
                    });

                    content += `
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>`;

                    modalContent.html(content); // Populate modal with data
                }).fail(function () {
                    modalContent.html('<p class="text-danger">Failed to load order details. Please try again.</p>');
                });
            });
        });
    </script>
}

