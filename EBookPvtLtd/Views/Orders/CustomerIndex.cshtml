@model IEnumerable<EBookPvtLtd.Models.Order>

@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<h1 class="mt-2">@ViewData["Title"]</h1>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Order Date</th>
            <th>Status</th>
            <th>First Name</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.OrderDate)</td>
                <td>
                    <span class="badge @((item.Status == "Completed") ? "bg-success" : (item.Status == "Pending") ? "bg-warning" : "bg-secondary")">
                        @Html.DisplayFor(modelItem => item.Status)
                    </span>
                </td>
                <td>@Html.DisplayFor(modelItem => item.Customer.FirstName)</td>
                <td class="text-center">
                    <button type="button" class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#detailsModal" data-order-id="@item.OrderId">
                        Details
                    </button>
                    @if (item.Status == "Pending")
                    {
                        <form asp-action="CancelOrder" asp-route-id="@item.OrderId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm">Cancel</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<!-- Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailsModalLabel">Order Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailsModalContent">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Attach event to buttons with data-bs-target="#detailsModal"
            $('#detailsModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget); // Button that triggered the modal
                var orderId = button.data('order-id'); // Extract info from data-order-id attribute

                // Make an AJAX call to fetch order details
                var modal = $(this);
                var modalContent = modal.find('#detailsModalContent');
                modalContent.html('<p>Loading...</p>'); // Placeholder content

                $.get('/Orders/Details/' + orderId, function (data) {
                    modalContent.html(data); // Replace modal content with the response
                }).fail(function () {
                    modalContent.html('<p class="text-danger">Failed to load order details. Please try again.</p>');
                });
            });

            $('#detailsModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget); // Button that triggered the modal
                var orderId = button.data('order-id'); // Extract info from data-order-id attribute
                var modalContent = $('#detailsModalContent');

                modalContent.html('<p>Loading...</p>'); // Placeholder

                // Fetch order details
                $.getJSON('/Orders/Details/' + orderId, function (data) {
                    var content = `
                                        <h4>Order Information</h4>
                                        <p><strong>Order ID:</strong> ${data.orderId}</p>
                                        <p><strong>Order Date:</strong> ${data.orderDate}</p>
                                        <p><strong>Status:</strong> ${data.status}</p>
                                        <p><strong>Total Amount:</strong> ${data.totalAmount}</p>
                                        <h4>Customer Information</h4>
                                        <p><strong>Name:</strong> ${data.customer.firstName} ${data.customer.lastName}</p>
                                        <p><strong>Email:</strong> ${data.customer.email}</p>
                                        <h4>Order Items</h4>
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>Title</th>
                                                    <th>Price</th>
                                                    <th>Quantity</th>
                                                    <th>Total Price</th>
                                                </tr>
                                            </thead>
                                            <tbody>`;

                    data.items.forEach(item => {
                        content += `
                                            <tr>
                                                <td>${item.title}</td>
                                                <td>${item.price}</td>
                                                <td>${item.quantity}</td>
                                                <td>${item.totalPrice}</td>
                                            </tr>`;
                    });

                    content += `
                                            </tbody>
                                        </table>`;

                    modalContent.html(content); // Populate modal with data
                }).fail(function () {
                    modalContent.html('<p class="text-danger">Failed to load order details. Please try again.</p>');
                });
            });
        });
    </script>
}

