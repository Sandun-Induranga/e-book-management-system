@model EBookPvtLtd.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<h1 class="mt-2">Order Details</h1>

<div class="mb-3">
    <h3>Order Information</h3>
    <p><strong>Order ID:</strong> @Model.OrderId</p>
    <p><strong>Order Date:</strong> @Model.OrderDate.ToString("yyyy-MM-dd")</p>
    <p>
        <strong>Status:</strong>
        <span class="badge @((Model.Status == "Completed") ? "bg-success" : (Model.Status == "Pending") ? "bg-warning" : "bg-secondary")">
            @Model.Status
        </span>
    </p>
    <p><strong>Total Amount:</strong> @Model.TotalAmount.ToString("C")</p>
</div>

<div class="mb-3">
    <h3>Customer Information</h3>
    <p><strong>Name:</strong> @Model.Customer.FirstName @Model.Customer.LastName</p>
    <p><strong>Email:</strong> @Model.Customer.Email</p>
</div>

<div class="mb-3">
    <h3>Order Items</h3>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Book Title</th>
                <th>Price (per unit)</th>
                <th>Quantity</th>
                <th>Total Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderItems)
            {
                <tr>
                    <td>@item.Book.Title</td>
                    <td>@item.Price</td>
                    <td>@item.Quantity</td>
                    <td>@(item.Price * item.Quantity).ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="CustomerIndex" class="btn btn-secondary">Back to My Orders</a>
